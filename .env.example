# Скопируйте в .env.local и заполните реальными значениями.
# .env.local в git не попадает.

# --- Supabase ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Gemini (AI-распознавание еды) ---
# Ключ: https://aistudio.google.com/apikey
# ВАЖНО: без префикса NEXT_PUBLIC_ — ключ не должен попадать в браузер.
GEMINI_API_KEY=AIza...

# --- Опционально ---
# Модель для фотоанализа (по умолчанию gemini-3.5-flash)
# GEMINI_PRIMARY_MODEL=gemini-3.5-flash
# Запасные модели; 3.6 иногда отдаёт 429/high demand, поэтому не ставьте её первой.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Публичный site key Cloudflare Turnstile; secret задаётся в Supabase Auth CAPTCHA.
# Обязателен для гостевого входа в production.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
