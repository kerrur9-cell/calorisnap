# Скопируйте в .env.local и заполните реальными значениями.
# .env.local в git не попадает.

# --- Supabase ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Gemini (AI-распознавание еды) ---
# Ключ: https://aistudio.google.com/apikey
# ВАЖНО: без префикса NEXT_PUBLIC_ — ключ не должен попадать в браузер.
GEMINI_API_KEY=AIza...
# Необязательный второй ключ Gemini: используется, если первый запрос не дал результата
# GEMINI_FALLBACK_API_KEY=

# Третий анализатор фото (Groq), только на сервере
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=openai/gpt-oss-20b

# --- Push-уведомления ---
# Сгенерируйте один раз: node scripts/generate-vapid-keys.mjs
# Секрет VAPID_PRIVATE_KEY и ключ Supabase service role задайте в Netlify Environment variables.
# На локальной машине VAPID_PRIVATE_KEY нужен для тестовых push.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://calorisnap-ai.netlify.app
# SUPABASE_SERVICE_ROLE_KEY=


# --- Опционально ---
# Дополнительный бесплатный анализ фото (только на сервере).
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# Модель для фотоанализа (по умолчанию gemini-3.5-flash)
# GEMINI_PRIMARY_MODEL=gemini-3.5-flash
# Запасная модель используется со вторым ключом после неудачной первой попытки.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Публичный site key Cloudflare Turnstile; secret задаётся в Supabase Auth CAPTCHA.
# Обязателен для гостевого входа в production.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional server-only Jev machine classification
# GROQ_FALLBACK_API_KEY= optional separate key for final equipment scan
TYPESAFE_API_KEY=
# Server-only admin credentials. Never use NEXT_PUBLIC_ for these.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
